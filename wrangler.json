{
  "name": "weeklytracker",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiktokcore-tracker",
      "database_id": "5fd0719f-3dae-4aa8-847e-7180cc052fd5",
      "migrations_dir": "migrations"
    }
  ]
}
